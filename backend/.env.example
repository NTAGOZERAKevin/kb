NODE_ENV=development
PORT=5000

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the connection pooler URI (port 6543) for the API and the direct URI for scripts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set to false when pointing at a local Postgres without TLS.
DATABASE_SSL=true

# Supabase project keys (Project Settings -> API). Optional for the API itself.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=replace-with-a-random-string-of-at-least-64-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_NAME=bom_token
TRUST_PROXY=0

ADMIN_NAME=Beauty Oil Market Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Image uploads (optional). Without Cloudinary, images are stored in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=

# Payments. "mock" returns a reference for manual confirmation.
PAYMENT_MODE=mock

# Email notifications (optional). Without SMTP, notifications stay in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional webhook for SMS/WhatsApp providers.
NOTIFICATION_WEBHOOK_URL=
