NODE_ENV=development
PORT=5000

# MongoDB connection string. Copy the URI from MongoDB Compass (local server) or
# MongoDB Atlas (Deployment -> Database -> Connect).
# Local: mongodb://127.0.0.1:27017/beauty-oil-market
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beauty-oil-market
MONGODB_URI=mongodb://127.0.0.1:27017/beauty-oil-market
# Optional: override the database name when it is not part of the URI.
MONGODB_DB=
MONGODB_POOL_MAX=10

JWT_SECRET=replace-with-a-random-string-of-at-least-64-characters
JWT_EXPIRES_IN=7d
# Comma-separated list of browser origins allowed to call the API.
# Add your deployed frontend here, e.g. http://localhost:5173,https://your-site.vercel.app
# In development, any localhost/127.0.0.1 port is allowed automatically.
CLIENT_URL=http://localhost:5173
COOKIE_NAME=bom_token
TRUST_PROXY=0

ADMIN_NAME=Sharon Glow Boutique Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Image uploads (optional). Without Cloudinary, images are stored in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=

# Payments. "mock" returns a reference for manual confirmation.
PAYMENT_MODE=mock

# Email notifications (optional). Without SMTP, notifications stay in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional webhook for SMS/WhatsApp providers.
NOTIFICATION_WEBHOOK_URL=
